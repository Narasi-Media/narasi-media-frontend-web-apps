{
  "name": "narasi-media-frontend-web-apps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "npm run build:dev && wrangler deploy --name narasi-media-web-dev",
    "deploy:prod": "npm run build:prod && wrangler deploy --name narasi-media-web"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "svelte": "^4.2.19",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "lucide-svelte": "^0.453.0"
  }
}
